MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=tweets
MYSQL_QUERY=SELECT texto AS text, etiqueta AS label FROM tweet WHERE etiqueta <> '' LIMIT 5000;

# Auth / tenancy
AUTH_SECRET_KEY=change_this_super_secret
AUTH_TOKEN_ALGORITHM=HS256
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=7
CHAT_AUTH_COMPAT_MODE=true

# Persistence backend: sqlite | memory
PERSISTENCE_BACKEND=sqlite
SQLITE_DB_PATH=data/local_api.db
DOC_STORAGE_BACKEND=local
AGENTS_KNOWLEDGE_ROOT=knowledge_base/agents
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PREFIX=agents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RUSTFS_ENDPOINT=
RUSTFS_PUBLIC_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_REGION=
AGENT_ORCHESTRATOR_USE_LLM=true

# LLM generation provider for RAG answers: auto | openai | anthropic
RAG_GENERATION_PROVIDER=auto

# OpenAI (used for generation and/or embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (used for generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
